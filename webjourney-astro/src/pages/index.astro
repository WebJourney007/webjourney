---
import BaseLayout from "../layouts/BaseLayout.astro";
import Accent from "../components/Accent.astro";
import Button from "../components/Button.astro";
import Cta from "../components/Cta.astro";
import Faq from "../components/Faq.astro";
import HeroCenter from "../components/HeroCenter.astro";
import LogoMarquee from "../components/LogoMarquee.astro";
import ProductSection from "../components/ProductSection.astro";
import Quote from "../components/Quote.astro";
import Section from "../components/Section.astro";
import SectionHead from "../components/SectionHead.astro";
import AppResults from "../components/dashboard/AppResults.astro";
import BrandBoard from "../components/dashboard/BrandBoard.astro";
import SiteResults from "../components/dashboard/SiteResults.astro";
import Split from "../components/Split.astro";
import Stats from "../components/Stats.astro";
import Steps from "../components/Steps.astro";
import Reviews from "../components/Reviews.astro";
import ReplyNote from "../components/ReplyNote.astro";
import { CLIENT_LOGOS } from "../data/clients";
import { faqStructuredData, homeFaq } from "../data/faq";
import {
  caseStudyStats,
  hero,
  methodSteps,
  structuredData,
  testimonials,
  videoReview,
} from "../data/home";
import { appProduct, designProduct, siteProduct } from "../data/products";
import { PROJECT_CTA, SITE } from "../lib/site";

---

<BaseLayout
  title="Agence web en Valais, sites internet sur mesure | Web journey"
  description="Agence web en Valais : sites internet sur mesure, visibles sur Google et dans les IA comme ChatGPT, identité visuelle et applications."
  ogDescription="Agence web en Valais. Sites internet sur-mesure, identité visuelle, développement performant. Des solutions claires, durables et bien pensées."
  path="/"
  structuredData={[...structuredData, faqStructuredData(homeFaq)]}
  navOverlay="light"
>
  <HeroCenter {...hero}>
    <h1>Agence web en Valais, des sites qui vous apportent <Accent text="des clients" /></h1>
    <p class="lead">
      Création de sites internet visibles sur Google et dans les IA, réservation en ligne et outils sur-mesure pour les
      PME valaisannes et romandes.
    </p>
    <div class="actions">
      <Button href={PROJECT_CTA.href} variant="accent" icon="arrow">{PROJECT_CTA.label}</Button>
      <Button href="/nos-sites-internet">Voir nos réalisations</Button>
    </div>
    <Fragment slot="proof">Plus de <strong>30 sites</strong> livrés pour des PME de Suisse romande</Fragment>
  </HeroCenter>

  <LogoMarquee logos={CLIENT_LOGOS} label="Nos clients" />

  <!-- Tout ce qui suit le premier écran repose sur un seul dégradé sombre. -->
  <div class="page-deep tone-ink">
  <!-- ─── PRODUITS : le produit phare, puis sa preuve ─── -->
  <Section id="sites">
    <ProductSection product={siteProduct} reverse>
      <SiteResults slot="media" />
    </ProductSection>
  </Section>

  <!-- ─── ÉTUDE DE CAS ─── -->
  <Section>
    <Split
      image="/assets/images/astral-motorclub--webjourney--use-2.webp"
      alt="Site web sur-mesure Astral Motorclub — réalisation Web Journey Valais"
      width={850}
      height={1133}
      ratio="4 / 5"
      reverse
    >
      <h2>Comment nous avons transformé <Accent text="Astral Motorclub" /></h2>
      <p>
        <a href="https://www.astral-motorclub.ch" target="_blank" rel="noopener noreferrer" class="text-link"
          >Astral Motorclub</a
        > loue des voitures de luxe à Genève, Paris, Monaco et sur la Côte d'Azur. Nous avons créé leur site et une
        application de réservation sur-mesure, et nous les accompagnons depuis pour faire croître leur activité.
      </p>
      <Stats items={caseStudyStats} />
      <Button href="/astral-motorclub" icon="arrow">Voir l'étude de cas</Button>
    </Split>
  </Section>

  <Section id="applications">
    <ProductSection product={appProduct} reverse>
      <AppResults slot="media" />
    </ProductSection>
  </Section>

  <Section id="design">
    <ProductSection product={designProduct}>
      <BrandBoard slot="media" />
    </ProductSection>
  </Section>

  <!-- ─── TÉMOIGNAGES ─── -->
  <Section>
    <div class="flow">
      <SectionHead>
        <Fragment slot="title">Ce que disent <Accent text="nos clients" /></Fragment>
      </SectionHead>
      <Reviews video={videoReview} items={testimonials} />
    </div>
  </Section>

  <!-- ─── MÉTHODE ─── -->
  <Section>
    <div class="flow">
      <SectionHead align="center">
        <Fragment slot="title">Un accompagnement <Accent text="de l'idée au lancement" /></Fragment>
        <p>Site internet, application ou identité visuelle : un seul interlocuteur du début à la fin.</p>
      </SectionHead>
      <Steps items={methodSteps} />
    </div>
  </Section>

  <!-- ─── FONDATEUR ─── -->
  <Section>
    <Quote
      image="/images/max-berton-fondateur-webjourney.png"
      alt="Maxime Berton, fondateur de Web journey"
      width={800}
      height={800}
      name="Maxime Berton"
      role="Fondateur de Web journey"
    >
      <p>
        Je m'appelle Maxime et je travaille depuis Sion. Chez Web journey, c'est moi qui suis votre projet, du premier
        rendez-vous jusqu'après la mise en ligne. Je vous réponds sous 24 h, et on se rencontre autour d'un café ou en
        visio. Mon objectif est simple : que votre site vous rapporte plus qu'il ne vous a coûté.
      </p>
    </Quote>
  </Section>

  <!-- ─── FAQ ─── -->
  <Section>
    <div class="two-col">
      <SectionHead>
        <Fragment slot="title">Vos questions, <Accent text="nos réponses" /></Fragment>
      </SectionHead>
      <Faq items={homeFaq} />
    </div>
  </Section>

  <!-- ─── APPEL À L'ACTION ─── -->
  <Section>
    <Cta>
      <Fragment slot="title">Votre entreprise mérite un site<br /><Accent text="à sa hauteur" /></Fragment>
      <p>
        Décrivez votre projet en quelques lignes : on vous dit ce dont vous avez vraiment besoin, et combien ça coûte.
        Gratuit et sans engagement.
      </p>
      <ReplyNote />
      <Fragment slot="actions">
        <Button href={PROJECT_CTA.href} variant="accent" icon="arrow">{PROJECT_CTA.label}</Button>
        <Button href={SITE.whatsapp} target="_blank" rel="noopener noreferrer" icon="whatsapp">
          {SITE.phoneDisplay}
        </Button>
      </Fragment>
    </Cta>
  </Section>
  </div>
</BaseLayout>

<style>
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5) var(--space-6);
  }
</style>
