---
import BaseLayout from "../layouts/BaseLayout.astro";
import Accent from "../components/Accent.astro";
import Button from "../components/Button.astro";
import CaseGrid from "../components/CaseGrid.astro";
import Cta from "../components/Cta.astro";
import ExplainList from "../components/ExplainList.astro";
import Faq from "../components/Faq.astro";
import HeroText from "../components/HeroText.astro";
import PriceBlock from "../components/PriceBlock.astro";
import ReplyNote from "../components/ReplyNote.astro";
import Section from "../components/Section.astro";
import SectionHead from "../components/SectionHead.astro";
import { faqStructuredData } from "../data/faq";
import { cases } from "../data/projects";
import { shopExamples, shopExcluded, shopFaq, shopIncluded, shopPrice, shopReasons, shopStructuredData } from "../data/boutique";
import { PROJECT_CTA } from "../lib/site";

const examples = cases.filter((item) => shopExamples.includes(item.href));
---

<BaseLayout
  title="Création de boutique en ligne en Valais | Web journey"
  description="Création de boutique en ligne sur-mesure en Valais et à Sion : e-commerce rapide, paiement sécurisé avec TWINT, sans commission de plateforme. Devis gratuit."
  path="/creation-boutique-en-ligne"
  structuredData={[shopStructuredData, faqStructuredData(shopFaq)]}
>
  <HeroText>
    <h1>Création de boutique en ligne <Accent text="en Valais" /></h1>
    <p class="lead">
      Vendez vos produits jour et nuit, avec un e-commerce sur-mesure, rapide et sécurisé, qui accepte TWINT. Sans
      commission de plateforme, et la boutique vous appartient.
    </p>
    <div class="actions">
      <Button href={PROJECT_CTA.href} variant="accent" icon="arrow">{PROJECT_CTA.label}</Button>
      <Button href="#prix">Voir le prix</Button>
    </div>
  </HeroText>

  <div class="page-deep tone-ink">
  <!-- ─── POURQUOI UNE BOUTIQUE SUR-MESURE ─── -->
  <Section>
    <div class="two-col">
      <SectionHead>
        <Fragment slot="title">Pourquoi une boutique <Accent text="sur-mesure ?" /></Fragment>
      </SectionHead>
      <ExplainList items={shopReasons} />
    </div>
  </Section>

  <!-- ─── PRIX ET PÉRIMÈTRE ─── -->
  <Section id="prix">
    <div class="flow">
      <SectionHead>
        <Fragment slot="title">Un prix fixe, <Accent text="sans surprise" /></Fragment>
        <p>
          Le prix dépend du nombre de produits et des fonctionnalités. Vous recevez un devis précis après un premier
          échange gratuit, sans commission cachée.
        </p>
      </SectionHead>
      <PriceBlock price={shopPrice} note="Jusqu'à 50 produits, livrée en 4 à 8 semaines" included={shopIncluded} excluded={shopExcluded} />
      <p class="muted">
        Un grand catalogue ou une connexion à vos outils ? Voir nos{" "}
        <a href="/creation-site-internet#formules" class="text-link">projets sur-mesure</a>. Pas besoin de vendre en ligne ?
        Voir le <a href="/creation-site-vitrine" class="text-link">site vitrine</a>.
      </p>
    </div>
  </Section>

  <!-- ─── EXEMPLES ─── -->
  <Section>
    <div class="flow">
      <div class="head-row">
        <SectionHead>
          <Fragment slot="title">Des boutiques <Accent text="déjà en ligne" /></Fragment>
        </SectionHead>
        <Button href="/nos-sites-internet" icon="arrow">Voir tous nos sites</Button>
      </div>
      <CaseGrid items={examples} />
    </div>
  </Section>

  <!-- ─── FAQ ─── -->
  <Section>
    <div class="two-col">
      <SectionHead>
        <Fragment slot="title">Questions sur <Accent text="votre boutique" /></Fragment>
      </SectionHead>
      <Faq items={shopFaq} />
    </div>
  </Section>

  <!-- ─── APPEL À L'ACTION ─── -->
  <Section>
    <Cta>
      <Fragment slot="title">Parlons de <Accent text="votre boutique" /></Fragment>
      <p>Décrivez votre boutique en quelques lignes : on la cadre avec vous et on la chiffre, gratuitement et sans engagement.</p>
      <ReplyNote />
      <Fragment slot="actions">
        <Button href={PROJECT_CTA.href} variant="accent" icon="arrow">{PROJECT_CTA.label}</Button>
        <Button href="/demander-un-devis">Demander un devis</Button>
      </Fragment>
    </Cta>
  </Section>
  </div>
</BaseLayout>

