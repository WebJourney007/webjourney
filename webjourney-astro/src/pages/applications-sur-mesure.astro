---
// Page du service « applications sur mesure » (B-009). Même squelette que
// `/identite-visuelle` : sur devis, donc ni formules ni tableau.
import BaseLayout from "../layouts/BaseLayout.astro";
import Accent from "../components/Accent.astro";
import Button from "../components/Button.astro";
import CaseGrid from "../components/CaseGrid.astro";
import Cta from "../components/Cta.astro";
import Faq from "../components/Faq.astro";
import HeroText from "../components/HeroText.astro";
import OtherServices from "../components/OtherServices.astro";
import PointList from "../components/PointList.astro";
import ReplyNote from "../components/ReplyNote.astro";
import Section from "../components/Section.astro";
import SectionHead from "../components/SectionHead.astro";
import Steps from "../components/Steps.astro";
import TestimonialCard from "../components/TestimonialCard.astro";
import { appFaq, appIncluded, appReview, appStructuredData } from "../data/applications";
import { faqStructuredData } from "../data/faq";
import { methodSteps } from "../data/home";
import { appProduct } from "../data/products";
import { cases } from "../data/projects";
import { PROJECT_CTA, SITE } from "../lib/site";

const path = "/applications-sur-mesure";
// Les réalisations de la famille « app » du filtre des réalisations.
const examples = cases.filter((item) => item.types.includes("app"));
---

<BaseLayout
  title="Application web sur mesure en Valais | Web journey"
  description="Applications web sur mesure en Valais : réservation en ligne, planning, location, connexion à votre logiciel de gestion. Sur devis, après étude de votre projet."
  path={path}
  structuredData={[appStructuredData, faqStructuredData(appFaq)]}
  navOverlay="dark"
>
  <HeroText tone="ink">
    <h1>Applications sur mesure en Valais, <Accent text="qui vous font gagner du temps" /></h1>
    <p class="lead">{appProduct.pitch}</p>
    <p class="muted">{appProduct.price} : {appProduct.priceNote.toLowerCase()}.</p>
    <div class="actions">
      <Button href={PROJECT_CTA.href} variant="accent" icon="arrow">{PROJECT_CTA.label}</Button>
      <Button href="#realisations">Voir les réalisations</Button>
    </div>
  </HeroText>

  <div class="page-deep tone-ink">
  <!-- ─── CE QUE LES APPLICATIONS FONT ─── -->
  <Section>
    <div class="flow">
      <SectionHead>
        <Fragment slot="title">Des outils qui <Accent text="travaillent pour vous" /></Fragment>
      </SectionHead>
      <PointList items={appIncluded} cols={2} />
    </div>
  </Section>

  <!-- ─── PREUVES ─── -->
  <Section id="realisations">
    <div class="flow">
      <div class="head-row">
        <SectionHead>
          <Fragment slot="title">Déjà <Accent text="en service" /></Fragment>
        </SectionHead>
        <Button href="/nos-sites-internet" icon="arrow">Voir toutes nos réalisations</Button>
      </div>
      <CaseGrid items={examples} />
      {appReview && (
        <div class="review">
          <TestimonialCard {...appReview} />
        </div>
      )}
    </div>
  </Section>

  <!-- ─── MÉTHODE ─── -->
  <Section>
    <div class="flow">
      <SectionHead>
        <Fragment slot="title">Trois <Accent text="étapes" /></Fragment>
        <p>Un seul interlocuteur du début à la fin. Vous validez, nous nous occupons du reste.</p>
      </SectionHead>
      <Steps items={methodSteps} />
    </div>
  </Section>

  <!-- ─── FAQ ─── -->
  <Section>
    <div class="two-col">
      <SectionHead>
        <Fragment slot="title">Questions sur <Accent text="votre application" /></Fragment>
      </SectionHead>
      <Faq items={appFaq} />
    </div>
  </Section>

  <!-- ─── AUTRES SERVICES ─── -->
  <OtherServices path={path} />

  <!-- ─── APPEL À L'ACTION ─── -->
  <Section>
    <Cta>
      <Fragment slot="title">Parlons de <Accent text="votre outil" /></Fragment>
      <p>
        Décrivez ce qui vous prend du temps aujourd'hui, en quelques lignes : on vous dit ce qu'on peut automatiser, puis
        on vous envoie un devis.
      </p>
      <ReplyNote />
      <Fragment slot="actions">
        <Button href={PROJECT_CTA.href} variant="accent" icon="arrow">{PROJECT_CTA.label}</Button>
        <Button href={SITE.whatsapp} target="_blank" rel="noopener noreferrer" icon="whatsapp">
          {SITE.phoneDisplay}
        </Button>
      </Fragment>
    </Cta>
  </Section>
  </div>
</BaseLayout>

<style>
  .review {
    max-width: 40rem;
  }
</style>
