---
// Page du service « identité visuelle » (B-009). Même squelette que
// `/applications-sur-mesure` : sur devis, donc ni formules ni tableau. Pas de
// témoignage : aucun avis client ne porte sur l'identité seule.
import BaseLayout from "../layouts/BaseLayout.astro";
import Accent from "../components/Accent.astro";
import Button from "../components/Button.astro";
import CaseGrid from "../components/CaseGrid.astro";
import Cta from "../components/Cta.astro";
import Faq from "../components/Faq.astro";
import HeroText from "../components/HeroText.astro";
import PointList from "../components/PointList.astro";
import ReplyNote from "../components/ReplyNote.astro";
import Section from "../components/Section.astro";
import SectionHead from "../components/SectionHead.astro";
import Split from "../components/Split.astro";
import Steps from "../components/Steps.astro";
import { faqStructuredData } from "../data/faq";
import { methodSteps } from "../data/home";
import { designFaq, designIncluded, designProcess, designStructuredData } from "../data/identite";
import { designProduct } from "../data/products";
import { cases } from "../data/projects";
import { PROJECT_CTA, SITE } from "../lib/site";

const path = "/identite-visuelle";
// Les réalisations de la famille « identite » du filtre des réalisations.
const examples = cases.filter((item) => item.types.includes("identite"));
---

<BaseLayout
  title="Identité visuelle et logo en Valais | Web journey"
  description="Identité visuelle en Valais : logo, charte graphique, cartes de visite, flyers et brochures. Une image cohérente du site au papier, sur devis."
  path={path}
  structuredData={[designStructuredData, faqStructuredData(designFaq)]}
  navOverlay="dark"
>
  <HeroText tone="ink">
    <h1>Identité visuelle et graphisme <Accent text="en Valais" /></h1>
    <p class="lead">{designProduct.pitch}</p>
  </HeroText>

  <div class="page-deep tone-ink">
  <!-- ─── CE QUE COMPREND UNE IDENTITÉ ─── -->
  <Section>
    <Split
      image="/assets/images/illustration--identite.webp"
      alt="Illustration : un logo, sa charte graphique (couleurs, typographie) et ses déclinaisons sur papier, site et mobile"
      width={1200}
      height={896}
      framed
      alignTop
    >
      <SectionHead slot="head">
        <Fragment slot="title">Une identité, <Accent text="du web au papier" /></Fragment>
      </SectionHead>
      <PointList items={designIncluded} cols={1} />
    </Split>
  </Section>

  <!-- ─── MÉTHODE EN IMAGES (WAPI) ─── -->
  <Section>
    <div class="flow flow--lg">
      <SectionHead>
        <Fragment slot="title">De la première idée <Accent text="au logo final" /></Fragment>
      </SectionHead>
      {designProcess.map((step, index) => {
        const number = String(index + 1).padStart(2, "0");
        const [first, ...others] = step.images;
        if (!first) return null;
        // Deux images : le texte au-dessus, les images côte à côte à la même hauteur.
        if (others.length > 0) {
          return (
            <div class="process__wide">
              <div class="process__text stack">
                <p class="process__step">{number}</p>
                <h3>{step.title}</h3>
                <p class="muted">{step.text}</p>
              </div>
              <div class="process__row">
                {step.images.map((image) => (
                  <img
                    src={image.src}
                    alt={image.alt}
                    width={image.width}
                    height={image.height}
                    loading="lazy"
                    decoding="async"
                    style={`flex-grow: ${image.width / image.height}`}
                  />
                ))}
              </div>
            </div>
          );
        }
        return (
          <Split image={first.src} alt={first.alt} width={first.width} height={first.height} reverse={index % 2 === 0}>
            <p class="process__step">{number}</p>
            <h3>{step.title}</h3>
            <p class="muted">{step.text}</p>
          </Split>
        );
      })}
    </div>
  </Section>

  <!-- ─── PREUVES ─── -->
  <Section id="realisations">
    <div class="flow">
      <div class="head-row">
        <SectionHead>
          <Fragment slot="title">Des marques <Accent text="déjà lancées" /></Fragment>
        </SectionHead>
        <Button href="/nos-sites-internet" icon="arrow">Voir toutes nos réalisations</Button>
      </div>
      <CaseGrid items={examples} />
    </div>
  </Section>

  <!-- ─── MÉTHODE ─── -->
  <Section>
    <div class="flow">
      <SectionHead>
        <Fragment slot="title">Trois <Accent text="étapes" /></Fragment>
        <p>Un seul interlocuteur du début à la fin. Vous validez, nous nous occupons du reste.</p>
      </SectionHead>
      <Steps items={methodSteps} />
    </div>
  </Section>

  <!-- ─── APPEL À L'ACTION ─── -->
  <Section>
    <Cta>
      <Fragment slot="title">Parlons de <Accent text="votre image" /></Fragment>
      <p>
        Décrivez votre activité en quelques lignes : on vous dit ce dont votre marque a besoin, puis
        on vous envoie un devis.
      </p>
      <ReplyNote />
      <Fragment slot="actions">
        <Button href={PROJECT_CTA.href} variant="accent" icon="arrow">{PROJECT_CTA.label}</Button>
        <Button href={SITE.whatsapp} target="_blank" rel="noopener noreferrer" icon="whatsapp">
          {SITE.phoneDisplay}
        </Button>
      </Fragment>
    </Cta>
  </Section>

  <!-- ─── FAQ ─── -->
  <Section>
    <div class="two-col">
      <SectionHead>
        <Fragment slot="title">Questions sur <Accent text="votre identité" /></Fragment>
      </SectionHead>
      <Faq items={designFaq} />
    </div>
  </Section>
  </div>
</BaseLayout>

<style>
  .process__step {
    color: var(--accent-text);
    font-size: var(--fs-small);
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .process__wide {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .process__text {
    --stack-gap: var(--space-5);

    max-width: 40rem;
  }

  .process__row {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .process__row img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-md);
  }

  /* Côte à côte : chaque image prend une largeur proportionnelle à son format
     (flex-grow = largeur / hauteur), donc les deux ont la même hauteur. */
  @media (min-width: 48em) {
    .process__row {
      flex-direction: row;
      align-items: flex-start;
    }

    .process__row img {
      flex-basis: 0;
      min-width: 0;
    }
  }
</style>
