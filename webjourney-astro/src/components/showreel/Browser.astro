---
// Fenêtre de navigateur du showreel. Prend la largeur de son parent ; la vidéo
// est pilotée par l'horloge du showreel, jamais en lecture automatique.
interface Props {
  /** Largeur / hauteur de l'écran (hors barre). */
  ratio: number;
  image?: string;
  video?: string;
  label?: string;
  small?: boolean;
}

const { ratio, image, video, label, small = false } = Astro.props;
---

<figure class:list={["browser", small && "browser--small"]}>
  <div class="browser__bar">
    <span class="browser__dots"><i></i><i></i><i></i></span>
    {label && <span class="browser__label">{label}</span>}
  </div>
  <div class="browser__screen" style={`aspect-ratio: ${ratio}`}>
    {video ? <video src={video} muted playsinline preload="auto"></video> : <img src={image} alt="" decoding="sync" />}
  </div>
</figure>

<style>
  .browser {
    width: 100%;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 0.08);
    border-radius: 16px;
    background-color: var(--coal-deep);
    box-shadow: 0 40px 100px rgb(0 0 0 / 0.4);
  }

  .browser__bar {
    display: flex;
    align-items: center;
    height: 46px;
    padding: 0 20px;
    border-bottom: 1px solid rgb(255 255 255 / 0.08);
  }

  .browser__dots {
    display: flex;
    gap: 8px;
  }

  .browser__dots i {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background-color: rgb(255 255 255 / 0.2);
  }

  .browser__label {
    width: 340px;
    height: 28px;
    margin: 0 auto;
    border-radius: 6px;
    background-color: rgb(255 255 255 / 0.07);
    color: rgb(245 245 245 / 0.6);
    font-size: 15px;
    line-height: 28px;
    text-align: center;
    transform: translateX(-30px);
  }

  .browser--small {
    border-radius: 10px;
  }

  .browser--small .browser__bar {
    height: 26px;
    padding: 0 12px;
  }

  .browser--small .browser__dots {
    gap: 5px;
  }

  .browser--small .browser__dots i {
    width: 7px;
    height: 7px;
  }

  .browser__screen {
    position: relative;
    overflow: hidden;
  }

  .browser__screen img,
  .browser__screen video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
</style>
