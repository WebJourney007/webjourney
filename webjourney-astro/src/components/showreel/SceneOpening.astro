---
// Scènes 1 à 3 : mot-symbole, accroche, mur de sites livrés.
import Browser from "./Browser.astro";
import Words from "./Words.astro";

const SLUGS = [
  "astral-motorclub", "cirque-de-noel", "dinoworld", "victor-rossi", "wapi", "insectopia",
  "varela-brothers", "cyclo-gordo", "la-meltingpote", "pirates-aventure", "audition-sante",
  "fanny-masson", "charlys-bike-store", "geneva-velo", "creatiz", "aleiko", "ara-concept", "g7",
];
const COLUMNS = 5;
const PER_COLUMN = 8;

// Chaque colonne démarre plus loin dans la liste : deux voisines ne montrent
// jamais le même site à la même hauteur.
const columns = Array.from({ length: COLUMNS }, (_, c) =>
  Array.from({ length: PER_COLUMN }, (_, r) => SLUGS[(c * 7 + r) % SLUGS.length]),
);
---

<section class="scene tone-deep s1">
  <div class="s1-center">
    <p class="s1-mark"><Words text="web journey" serif /></p>
    <span class="s1-line"></span>
    <p class="s1-tag">Agence web à Sion, en Valais</p>
  </div>
</section>

<section class="scene tone-light s2">
  <h2 class="title s2-title">
    <span class="line"><Words text="Des sites qui" /></span>
    <span class="line s2-accent"><Words text="travaillent" serif /></span>
    <span class="line"><Words text="pour vous." /></span>
  </h2>
  <ul class="s2-services">
    <li><b>01</b> Sites internet</li>
    <li><b>02</b> Réservations en ligne</li>
    <li><b>03</b> Identité visuelle</li>
  </ul>
</section>

<section class="scene tone-dark s3">
  <div class="s3-zoom">
    <div class="s3-wall">
      {columns.map((column) => (
        <div class="s3-col">
          {column.map((slug) => (
            <div class="s3-card">
              <Browser small ratio={850 / 438} image={`/assets/images/${slug}--webjourney--web.webp`} />
            </div>
          ))}
        </div>
      ))}
    </div>
  </div>
  <div class="s3-veil"></div>
  <h2 class="title s3-title">
    <span class="line"><Words text="Chaque site," /></span>
    <span class="line gold"><Words text="sur mesure." serif /></span>
  </h2>
</section>

<style>
  .s1-center {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .s1-mark {
    font-size: 210px;
    line-height: 1;
  }

  .s1-line {
    width: 560px;
    height: 2px;
    margin-top: 44px;
    background-color: var(--accent);
  }

  .s1-tag {
    margin-top: 36px;
    color: var(--muted-on-dark);
    font-size: 30px;
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  .s2-title {
    position: absolute;
    top: 170px;
    left: 140px;
    font-size: 168px;
  }

  .s2-accent {
    margin-block: -10px 10px;
    color: var(--accent-strong);
    font-size: 220px;
    line-height: 1;
  }

  .s2-services {
    position: absolute;
    right: 140px;
    bottom: 150px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    font-size: 30px;
    font-weight: 500;
  }

  .s2-services b {
    display: inline-block;
    width: 52px;
    color: var(--accent-strong);
  }

  .s3-zoom {
    position: absolute;
    inset: 0;
    perspective: 2600px;
  }

  .s3-wall {
    position: absolute;
    top: 50%;
    left: 50%;
    display: flex;
    gap: 40px;
    transform: translate(-50%, -50%) rotateX(32deg) rotateZ(-20deg);
  }

  .s3-col {
    display: flex;
    flex-direction: column;
    gap: 40px;
    width: 520px;
  }

  .s3-veil {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 60% 55% at 50% 50%, rgb(23 21 19 / 0.88), rgb(23 21 19 / 0.25));
  }

  .s3-title {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    font-size: 150px;
    text-align: center;
  }

  .s3-title .gold {
    font-size: 190px;
    line-height: 1;
  }
</style>
