---
// Citation signée, avec le portrait de son auteur.
interface Props {
  image: string;
  alt: string;
  width: number;
  height: number;
  name: string;
  role: string;
}

const { image, alt, width, height, name, role } = Astro.props;
---

<figure class="quote">
  <img src={image} alt={alt} width={width} height={height} loading="lazy" decoding="async" class="quote__photo" />
  <div class="quote__body">
    <blockquote class="quote__text lead">
      <slot />
    </blockquote>
    <figcaption>
      <span class="quote__name">{name}</span>
      <span class="quote__role">{role}</span>
    </figcaption>
  </div>
</figure>

<style>
  .quote {
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }

  .quote__photo {
    width: min(100%, 16rem);
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radius-md);
  }

  .quote__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  /* L'accroche est plus grosse que le texte courant : sa largeur est recalculée
     pour rester autour de 65 caractères par ligne. */
  .quote__text,
  .quote__text :global(p) {
    max-width: 30em;
  }

  .quote__name,
  .quote__role {
    display: block;
    line-height: 1.35;
  }

  .quote__name {
    font-weight: 700;
  }

  .quote__role {
    color: var(--fg-muted);
    font-size: var(--fs-small);
  }

  @media (min-width: 48em) {
    .quote {
      grid-template-columns: 16rem 1fr;
      gap: var(--space-8);
    }
  }
</style>
