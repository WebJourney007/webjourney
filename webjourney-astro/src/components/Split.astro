---
// Image d'un côté, texte de l'autre. Sur mobile l'image passe toujours en premier.
interface Props {
  image: string;
  alt: string;
  width: number;
  height: number;
  /** Place l'image à droite sur desktop. */
  reverse?: boolean;
  /** Proportion du cadre de l'image, ex. "4 / 5". Par défaut, celle du fichier. */
  ratio?: string;
}

const { image, alt, width, height, reverse = false, ratio } = Astro.props;
---

<div class:list={["split", reverse && "split--reverse"]}>
  <div class="split__media" style={ratio ? `aspect-ratio: ${ratio}` : undefined}>
    <img src={image} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
  </div>
  <div class="split__content stack">
    <slot />
  </div>
</div>

<style>
  .split {
    display: grid;
    gap: var(--space-7);
    align-items: center;
  }

  .split__media {
    overflow: hidden;
    border-radius: var(--radius-md);
  }

  .split__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .split__content {
    --stack-gap: var(--space-5);
  }

  @media (min-width: 62em) {
    .split {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-8);
    }

    .split--reverse .split__media {
      order: 2;
    }
  }
</style>
