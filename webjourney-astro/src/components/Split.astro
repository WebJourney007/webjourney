---
// Image d'un côté, texte de l'autre. Sur mobile l'image passe toujours en premier.
interface Props {
  image: string;
  alt: string;
  width: number;
  height: number;
  /** Place l'image à droite sur desktop. */
  reverse?: boolean;
  /** Proportion du cadre de l'image, ex. "4 / 5". Par défaut, celle du fichier. */
  ratio?: string;
  /** Filet autour de l'image : pour une illustration sur fond sombre, dont le bord se devine sinon. */
  framed?: boolean;
  /** Image calée en haut, sur le titre, quand le texte est bien plus haut qu'elle. */
  alignTop?: boolean;
}

const { image, alt, width, height, reverse = false, ratio, framed = false, alignTop = false } = Astro.props;
---

<div class:list={["split", reverse && "split--reverse", alignTop && "split--top"]}>
  <div class:list={["split__media", framed && "split__media--framed"]} style={ratio ? `aspect-ratio: ${ratio}` : undefined}>
    <img src={image} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
  </div>
  <div class="split__content stack">
    <slot />
  </div>
</div>

<style>
  .split {
    display: grid;
    gap: var(--space-7);
    align-items: center;
  }

  .split--top {
    align-items: start;
  }

  .split__media {
    overflow: hidden;
    border-radius: var(--radius-md);
  }

  .split__media--framed {
    border: 1px solid var(--line);
  }

  .split__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .split__content {
    --stack-gap: var(--space-5);
  }

  @media (min-width: 62em) {
    .split {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-8);
    }

    .split--reverse .split__media {
      order: 2;
    }

    /* Image calée en haut : elle reste à l'écran pendant qu'on lit le texte, sous
       la barre de navigation quand celle-ci réapparaît. */
    .split--top .split__media {
      position: sticky;
      top: calc(var(--nav-height) + var(--space-6));
    }
  }
</style>
