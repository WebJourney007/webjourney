---
// Bloc « Nos autres services », en bas des trois pages services (B-009) : les
// deux services autres que celui de la page, chacun avec son lien.
import Accent from "./Accent.astro";
import ExplainList, { type Explain } from "./ExplainList.astro";
import Section from "./Section.astro";
import SectionHead from "./SectionHead.astro";
import { SERVICE_LINKS } from "../lib/site";

interface Props {
  /** Chemin de la page courante, exclu de la liste. */
  path: string;
}

const { path } = Astro.props;
const items: Explain[] = SERVICE_LINKS.filter((service) => service.href !== path).map(({ label, text, href }) => ({
  title: label,
  text,
  href,
}));
---

<Section>
  <div class="two-col">
    <SectionHead>
      <Fragment slot="title">Nos autres <Accent text="services" /></Fragment>
    </SectionHead>
    <ExplainList items={items} />
  </div>
</Section>
