---
// Les formules d'un coup d'œil : nom, prix en très grand, pour qui, délai.
// Rien d'autre : le détail ligne à ligne vit dans le comparatif juste après.
export interface GlanceItem {
  name: string;
  price: string;
  audience: string;
  delay: string;
  featured?: boolean;
}

interface Props {
  items: GlanceItem[];
}

const { items } = Astro.props;
---

<ul class="glance" style={`--items: ${items.length}`}>
  {items.map((item) => (
    <li class:list={["glance__item", item.featured && "glance__item--featured"]}>
      <h3 class="glance__name">
        {item.name}
        {item.featured && <span class="glance__badge">Recommandé</span>}
      </h3>
      <p class="glance__price">{item.price}</p>
      <p class="glance__audience">{item.audience}</p>
      <p class="glance__delay muted">{item.delay}</p>
    </li>
  ))}
</ul>

<style>
  .glance {
    display: grid;
  }

  /* Colonnes séparées par un filet, sans cadre : on lit trois prix, pas trois cartes. */
  .glance__item {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding-block: var(--space-6);
    border-top: 1px solid var(--line);
  }

  .glance__item--featured .glance__price {
    color: var(--color-accent);
  }

  .glance__name {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--fs-h3);
  }

  .glance__badge {
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-sm);
    background-color: var(--color-accent);
    color: var(--color-ink);
    font-size: var(--fs-small);
    font-weight: 700;
    line-height: 1.4;
  }

  .glance__price {
    /* Plafond calé sur le tiers de conteneur : « dès CHF 990.– » tient sur une ligne. */
    font-size: clamp(2.25rem, 3.2vw, 2.75rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .glance__audience {
    font-size: var(--fs-lead);
    line-height: 1.3;
  }

  @media (min-width: 62em) {
    .glance {
      grid-template-columns: repeat(var(--items), 1fr);
    }

    .glance__item {
      padding-inline: var(--space-5);
      border-top: 0;
      border-left: 1px solid var(--line);
    }

    .glance__item:first-child {
      padding-left: 0;
      border-left: 0;
    }
  }
</style>
