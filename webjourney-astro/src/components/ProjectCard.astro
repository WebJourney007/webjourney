---
// Carte de réalisation : visuel plein cadre, nom et prestations en légende.
interface Props {
  href: string;
  name: string;
  /** Prestations réalisées, affichées sous le nom. */
  categories: string[];
  image: string;
  alt: string;
  width: number;
  height: number;
}

const { href, name, categories, image, alt, width, height } = Astro.props;
---

<a href={href} class="project">
  <img src={image} alt={alt} width={width} height={height} loading="lazy" decoding="async" class="project__img" />
  <div class="project__label">
    <h3 class="project__name">{name}</h3>
    <p class="project__cats">{categories.join(" · ")}</p>
  </div>
</a>

<style>
  .project {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-md);
    background-color: var(--color-ink);
    color: var(--color-paper);
  }

  .project__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }

  /* Dégradé sous la légende : le texte reste lisible sur n'importe quel visuel. */
  .project__label {
    position: absolute;
    inset: auto 0 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-8) var(--space-5) var(--space-5);
    background-image: linear-gradient(to top, rgb(0 0 0 / 0.8), transparent);
  }

  .project__name {
    font-size: var(--fs-h3);
  }

  .project__cats {
    font-size: var(--fs-small);
    line-height: 1.4;
  }

  .project:hover .project__img,
  .project:focus-visible .project__img {
    transform: scale(1.04);
  }
</style>
