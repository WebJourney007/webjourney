---
// Promesse de délai de réponse, posée sous les boutons de contact.
import { SITE } from "../lib/site";
---

<p class="reply-note">
  <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
    <circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
    <path d="M8 4.5V8l2.5 1.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
  </svg>
  {SITE.replyPromise}
</p>

<style>
  .reply-note {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--fg-muted);
    font-size: var(--fs-small);
  }

  .reply-note svg {
    flex-shrink: 0;
    color: var(--color-accent);
  }
</style>
