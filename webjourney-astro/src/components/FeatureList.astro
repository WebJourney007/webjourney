---
// Rangs visuel + texte qui alternent, repris des rangs image / texte d'Astral :
// le visuel à gauche et le texte à droite, puis l'inverse au rang suivant. Chaque
// texte tient en un petit titre souligné d'un filet et un court paragraphe.
// Sous 992 px, le visuel passe au-dessus de son texte.
export interface FeatureMedia {
  /** Image fixe, au format 900 × 464 comme les captures du premier écran. */
  image: string;
  alt: string;
  /** Boucle vidéo muette (MP4, même format) jouée par-dessus l'image, au survol du visuel ou d'un tap sur sa pastille. */
  video?: string;
}

export interface Feature {
  title: string;
  text: string;
  media?: FeatureMedia;
}

interface Props {
  items: Feature[];
  /** Niveau des titres de rang, selon le titre de la section qui les contient. */
  headingLevel?: "h2" | "h3";
}

const { items, headingLevel: Heading = "h3" } = Astro.props;
---

<ol class="features">
  {items.map((item, index) => (
    <li class="features__item">
      {item.media && (
        <figure class="features__media" data-feature-media>
          <img src={item.media.image} alt={item.media.alt} width="900" height="464" loading="lazy" decoding="async" />
          {item.media.video && (
            <>
              <video src={item.media.video} muted loop playsinline preload="none" aria-hidden="true" tabindex="-1" />
              <button
                type="button"
                class="features__play"
                aria-label={`Lire la vidéo : ${item.title}`}
                data-label-play={`Lire la vidéo : ${item.title}`}
                data-label-pause={`Mettre en pause la vidéo : ${item.title}`}
              />
            </>
          )}
        </figure>
      )}
      <div class="features__body">
        <Heading class="features__title">{item.title}</Heading>
        <p>{item.text}</p>
      </div>
    </li>
  ))}
</ol>

<script>
  // Au repos tout est fixe : une vidéo ne joue que si le visiteur la demande, pour
  // que rien ne tire l'œil pendant la lecture du rang voisin. À la souris, il
  // suffit de survoler le visuel ; au doigt ou au clavier, la pastille lance et
  // arrête la vidéo. Rien n'est téléchargé avant.
  import { wantsVideo } from "../scripts/wants-video";

  const players = [...document.querySelectorAll<HTMLElement>("[data-feature-media]")].flatMap((media) => {
    const video = media.querySelector("video");
    const button = media.querySelector<HTMLButtonElement>(".features__play");
    return video && button ? [{ media, video, button }] : [];
  });

  // Le survol est un lancement automatique : il suit les garde-fous du premier écran.
  const hover = wantsVideo() && matchMedia("(hover: hover)").matches;

  // Une vidéo sortie de l'écran ne tourne pas pour rien.
  const offscreen = new IntersectionObserver((entries) => {
    for (const entry of entries) {
      if (!entry.isIntersecting) entry.target.querySelector("video")?.pause();
    }
  });

  for (const { media, video, button } of players) {
    // Une seule vidéo à la fois. Lecture refusée par le navigateur : l'image reste.
    const play = () => {
      for (const other of players) if (other.video !== video) other.video.pause();
      video.play().catch(() => {});
    };

    video.addEventListener("playing", () => {
      media.classList.add("is-playing");
      button.setAttribute("aria-label", button.dataset.labelPause ?? "");
    });
    video.addEventListener("pause", () => {
      media.classList.remove("is-playing");
      button.setAttribute("aria-label", button.dataset.labelPlay ?? "");
    });

    button.addEventListener("click", () => (video.paused ? play() : video.pause()));
    if (hover) {
      // Un doigt déclenche aussi ces événements : seul le pointeur de la souris compte.
      media.addEventListener("pointerenter", (event) => event.pointerType === "mouse" && play());
      media.addEventListener("pointerleave", (event) => event.pointerType === "mouse" && video.pause());
    }

    offscreen.observe(media);
    // Affiche la pastille : sans script, elle ne servirait à rien.
    media.classList.add("is-ready");
  }
</script>

<style>
  /* Un rang par regard : assez d'air pour lire un service sans que le suivant
     n'entre dans le champ. */
  .features {
    display: grid;
    gap: 7.5rem;
  }

  .features__item {
    display: grid;
    gap: var(--space-5);
    max-width: none;
  }

  .features__body {
    max-width: 32rem;
  }

  /* Même cadre que les captures du premier écran, sans ombre ni filet : quatre
     cadres appuyés à la suite alourdiraient le bloc. */
  .features__media {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-md);
    background-color: var(--color-ink);
  }

  .features__media img {
    width: 100%;
  }

  /* La vidéo recouvre l'image et n'apparaît qu'une fois la lecture lancée. */
  .features__media video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.6s ease;
  }

  .features__media.is-playing video {
    opacity: 1;
  }

  /* Pastille « lecture / pause » : signale qu'il y a une vidéo et la commande au
     doigt et au clavier. 44 px, la taille d'une cible tactile. Elle n'apparaît
     que si le script a pris la vidéo en charge. */
  .features__play {
    position: absolute;
    right: var(--space-4);
    bottom: var(--space-4);
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background-color: rgb(30 30 30 / 0.82);
    visibility: hidden;
  }

  .features__media.is-ready .features__play {
    visibility: visible;
  }

  /* Triangle de lecture. */
  .features__play::before {
    content: "";
    margin-left: 0.2rem;
    border-block: 0.4rem solid transparent;
    border-left: 0.65rem solid var(--color-paper);
  }

  /* Deux barres de pause pendant la lecture. */
  .features__media.is-playing .features__play::before {
    width: 0.65rem;
    height: 0.8rem;
    margin-left: 0;
    border-block: 0;
    border-inline: 0.22rem solid var(--color-paper);
  }

  .features__title {
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--fg);
    font-size: var(--fs-h3);
    line-height: 1.25;
  }

  @media (min-width: 62em) {
    .features {
      gap: 15rem;
    }

    .features__item {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-8);
      align-items: center;
    }

    /* Un rang sur deux inverse : le visuel passe à droite, le texte à gauche. */
    .features__item:nth-child(even) .features__media {
      order: 2;
    }
  }
</style>
