---
// Bandeau de contact au-dessus de la navigation : téléphone, et email sur desktop.
// Il défile avec la page ; seule la barre de navigation reste collée en haut.
import { SITE } from "../lib/site";
---

<div class="topbar tone-ink" data-topbar>
  <div class="container topbar__inner">
    <a href={SITE.phoneHref} class="topbar__link">{SITE.phoneDisplay}</a>
    <a href={`mailto:${SITE.email}`} class="topbar__link topbar__email">{SITE.email}</a>
  </div>
</div>

<style>
  .topbar {
    font-size: 0.8125rem;
    line-height: 1.2;
  }

  .topbar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    height: var(--topbar-height);
  }

  /* Le lien prend toute la hauteur du bandeau : c'est sa zone de clic. */
  .topbar__link {
    display: flex;
    align-items: center;
    height: 100%;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.3em;
    transition:
      color 0.2s ease,
      text-decoration-color 0.2s ease;
  }

  .topbar__link:hover,
  .topbar__link:focus-visible {
    color: var(--color-accent);
    text-decoration-color: currentColor;
  }

  /* Mobile et tablette : le téléphone seul. */
  @media (max-width: 61.99em) {
    .topbar__email {
      display: none;
    }
  }

  @media (min-width: 62em) {
    .topbar__inner {
      justify-content: flex-end;
      gap: var(--space-6);
    }
  }
</style>
