{
	// ─────────────────────────────────────────────────────────────
	// Formatage par langage
	// ─────────────────────────────────────────────────────────────
	"[dotenv]": { "editor.defaultFormatter": "foxundermoon.shell-format" },
	"[ignore]": { "editor.defaultFormatter": "foxundermoon.shell-format" },
	"[json]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode",
		"editor.formatOnSave": true
	},
	"[jsonc]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode",
		"editor.formatOnSave": true
	},
	"[shellscript]": {
		"editor.defaultFormatter": "foxundermoon.shell-format",
		"editor.formatOnSave": true
	},

	// ─────────────────────────────────────────────────────────────
	// Éditeur
	// ─────────────────────────────────────────────────────────────
	"editor.defaultFormatter": "esbenp.prettier-vscode",
	"editor.fontFamily": "Fira Code, FiraCode Nerd Font Mono",
	"editor.codeLensFontFamily": "Fira Code, FiraCode Nerd Font Mono",
	"editor.fontSize": 16,
	"editor.fontLigatures": "'cv01', 'cv02', 'cv10', 'ss02', 'cv11', 'cv14', 'ss05','ss03','ss09','cv25','cv26','cv32','cv27','ss06','ss07'",
	"editor.formatOnPaste": true,
	"editor.formatOnSave": true,
	"editor.formatOnType": false,
	"editor.insertSpaces": false,
	"editor.tabSize": 2,
	"editor.cursorSmoothCaretAnimation": "on",
	"editor.smoothScrolling": true,
	"editor.mouseWheelZoom": true,
	"editor.renderWhitespace": "trailing",
	"editor.acceptSuggestionOnCommitCharacter": false,
	"editor.accessibilitySupport": "off",
	"editor.codeActionsOnSave": {
		"source.fixAll.eslint": "never",
		"source.organizeImports": "never",
		"source.sortImports": "explicit"
	},
	"editor.guides.bracketPairs": true,
	"editor.guides.bracketPairsHorizontal": "active",
	"editor.guides.highlightActiveBracketPair": true,
	"editor.guides.highlightActiveIndentation": true,
	"editor.hover.enabled": "on",
	"editor.inlayHints.padding": true,
	"editor.minimap.showSlider": "always",
	"editor.minimap.size": "fit",
	"editor.scrollbar.verticalScrollbarSize": 8,
	"editor.suggest.insertMode": "replace",
	"editor.suggestSelection": "first",
	"editor.unicodeHighlight.ambiguousCharacters": false,
	"editor.unicodeHighlight.nonBasicASCII": false,
	"editor.find.cursorMoveOnType": false,

	// ─────────────────────────────────────────────────────────────
	// Prettier (cohérent avec tabs)
	// ─────────────────────────────────────────────────────────────
	"prettier.tabWidth": 2,
	"prettier.useTabs": true,

	// ─────────────────────────────────────────────────────────────
	// JS / TS
	// ─────────────────────────────────────────────────────────────
	"js/ts.inlayHints.enumMemberValues.enabled": true,
	"js/ts.preferences.importModuleSpecifierEnding": "js",
	"js/ts.updateImportsOnFileMove.enabled": "always",

	// ─────────────────────────────────────────────────────────────
	// Fichiers & explorateur
	// ─────────────────────────────────────────────────────────────
	"files.associations": {
		"*.cfg": "cuda-cpp",
		".env*": "dotenv"
	},
	"files.defaultLanguage": "markdown",
	"files.exclude": {
		"**/.classpath": true,
		"**/.factorypath": true,
		"**/.git": true,
		"**/.project": true,
		"**/.settings": true
	},
	"explorer.compactFolders": false,
	"explorer.confirmDragAndDrop": false,
	"emmet.triggerExpansionOnTab": true,
	"json.maxItemsComputed": 8000,

	// ─────────────────────────────────────────────────────────────
	// Git
	// ─────────────────────────────────────────────────────────────
	"git.autofetch": true,
	"git.blame.editorDecoration.enabled": false,
	"git.confirmSync": false,
	"git.enableSmartCommit": true,

	// ─────────────────────────────────────────────────────────────
	// Icônes (material-icon-theme + material-product-icons)
	// ─────────────────────────────────────────────────────────────
	"workbench.iconTheme": "material-icon-theme",
	"workbench.productIconTheme": "material-product-icons",
	"material-icon-theme.activeIconPack": "react",
	"material-icon-theme.files.color": "#26a69a",
	"material-icon-theme.folders.theme": "specific",
	"material-icon-theme.hidesExplorerArrows": true,
	"material-icon-theme.opacity": 1,
	"material-icon-theme.saturation": 1,

	// ─────────────────────────────────────────────────────────────
	// Thème & workbench
	// ─────────────────────────────────────────────────────────────
	"window.autoDetectColorScheme": true,
	"workbench.colorTheme": "Monokai Pro (Filter Spectrum)",
	"workbench.preferredDarkColorTheme": "Monokai Dimmed",
	"workbench.preferredLightColorTheme": "Solarized Light",
	"workbench.preferredHighContrastColorTheme": "Light+",
	"workbench.activityBar.location": "top",
	"workbench.editor.labelFormat": "short",
	"workbench.editor.limit.value": 5,
	"workbench.editor.tabActionCloseVisibility": false,
	"workbench.panel.showLabels": false,
	"workbench.tree.indent": 18,
	"workbench.colorCustomizations": {
		"activityBar.foreground": "#ff0000",
		"editorBracketHighlight.foreground1": "#19f9d8",
		"editorBracketHighlight.foreground2": "#e371ff",
		"editorBracketHighlight.foreground3": "#4b9fff",
		"editorBracketHighlight.foreground4": "#ffff40",
		"editorBracketHighlight.foreground5": "#f51384",
		"editorBracketHighlight.foreground6": "#31ff6f",
		"editorBracketPairGuide.activeBackground1": "#19f9d8",
		"editorBracketPairGuide.activeBackground2": "#cc00ff",
		"editorBracketPairGuide.activeBackground3": "#0077ff",
		"editorBracketPairGuide.activeBackground4": "#ffff00",
		"editorBracketPairGuide.activeBackground5": "#F513849E",
		"editorBracketPairGuide.activeBackground6": "#00ff4c",
		"editorBracketPairGuide.background1": "#2e9081",
		"editorBracketPairGuide.background2": "#85209f",
		"editorBracketPairGuide.background3": "#325a89",
		"editorBracketPairGuide.background4": "#717118",
		"editorBracketPairGuide.background5": "#f513849E",
		"editorBracketPairGuide.background6": "#1a933e",
		"panel.dropBackground": "#ff0000"
	},

	// ─────────────────────────────────────────────────────────────
	// Markdown Preview Enhanced
	// ─────────────────────────────────────────────────────────────
	"markdown-preview-enhanced.codeBlockTheme": "vscode.css",
	"markdown-preview-enhanced.enablePreviewZenMode": true,
	"markdown-preview-enhanced.previewTheme": "vscode.css",
	"markdown-preview-enhanced.revealjsTheme": "moon.css",

	// ─────────────────────────────────────────────────────────────
	// statusbarerror (cosmétique)
	// ─────────────────────────────────────────────────────────────
	"statusbarerror.color.error": "#ffd0d0",
	"statusbarerror.color.hint": "#ffee00",
	"statusbarerror.color.info": "#d0e4ff",
	"statusbarerror.icon.error": "❕",
	"statusbarerror.icon.hint": "💡",
	"statusbarerror.icon.info": "⏭",
	"statusbarerror.icon.warning": "❔",
	"statusbarerror.wholeLine.errorColor": "#363636",
	"statusbarerror.wholeLine.errorFontColor": "#777777",
	"statusbarerror.wholeLine.show": true,
	"statusbarerror.wholeLine.warningColor": "#ff980090",
	"statusbarerror.wholeLine.warningFontColor": "#efefef",

	// ─────────────────────────────────────────────────────────────
	// Terminal
	// ─────────────────────────────────────────────────────────────
	"terminal.integrated.copyOnSelection": true,
	"terminal.integrated.defaultProfile.windows": "Windows PowerShell",
	"terminal.integrated.enableVisualBell": true,
	"terminal.integrated.fontFamily": "CaskaydiaCove Nerd Font Mono, Fira Code, FiraCode Nerd Font Mono",
	"terminal.integrated.fontSize": 13,
	"terminal.integrated.initialHint": false,
	"terminal.integrated.rightClickBehavior": "paste",
	"terminal.integrated.tabs.defaultColor": "terminal.ansiCyan",
	"terminal.integrated.wordSeparators": " ()[]{}',\"`─",
	"terminal.integrated.profiles.windows": {
		"Command Prompt": {
			"args": [],
			"icon": "terminal-cmd",
			"path": [
				"${env:windir}\\Sysnative\\cmd.exe",
				"${env:windir}\\System32\\cmd.exe"
			]
		},
		"PowerShell 7": {
			"path": "C:\\Program Files\\PowerShell\\7\\pwsh.exe",
			"source": "PowerShell"
		}
	},

	// ─────────────────────────────────────────────────────────────
	// Sécurité / divers
	// ─────────────────────────────────────────────────────────────
	"security.promptForLocalFileProtocolHandling": false,
	"security.workspace.trust.untrustedFiles": "open",
	"search.followSymlinks": false,
	"settingsSync.keybindingsPerPlatform": true,
	"projectManager.sortList": "Name"
}
